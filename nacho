var crawl = [];
var currentNeighborhood = 'all';
var currentTag = 'all';
var activeFilters = [];
var routeStartIndex = {};
var visits = {};
var popupNachoId = null;

function switchTab(tab) {
  document.getElementById('tab-browse').classList.toggle('active', tab === 'browse');
  document.getElementById('tab-visits').classList.toggle('active', tab === 'visits');
  document.getElementById('panel-browse').style.display = tab === 'browse' ? 'block' : 'none';
  document.getElementById('panel-visits').style.display = tab === 'visits' ? 'block' : 'none';
  if (tab === 'visits') renderVisits();
}

function filterNeighborhood(nbhd, btn) {
  currentNeighborhood = nbhd;
  document.querySelectorAll('.neighborhood-btn').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
  document.getElementById('section-title').textContent = nbhd === 'all' ? 'All Portland' : nbhd;
  renderCards();
}

function filterTag(tag, btn) {
  currentTag = tag;
  document.querySelectorAll('.type-btn').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
  renderCards();
}

function toggleFilter(filter, btn) {
  var idx = activeFilters.indexOf(filter);
  if (idx > -1) { activeFilters.splice(idx, 1); btn.classList.remove('active'); }
  else { activeFilters.push(filter); btn.classList.add('active'); }
  renderCards();
}

function getFiltered() {
  var q = document.getElementById('search-input').value.toLowerCase();
  return NACHOS.filter(function(n) {
    var matchNbhd = currentNeighborhood === 'all' || n.neighborhood === currentNeighborhood;
    var matchTag = currentTag === 'all' || n.tags.indexOf(currentTag) > -1;
    var matchSearch = !q || n.restaurant.toLowerCase().indexOf(q) > -1 || n.nachoName.toLowerCase().indexOf(q) > -1 || n.desc.toLowerCase().indexOf(q) > -1 || n.address.toLowerCase().indexOf(q) > -1;
    var matchFilters = activeFilters.length === 0 || activeFilters.every(function(f) { return n.tags.indexOf(f) > -1; });
    return matchNbhd && matchTag && matchSearch && matchFilters;
  });
}

function inCrawl(id) { return crawl.some(function(n) { return n.id === id; }); }

function toggleCrawl(id) {
  var nacho = NACHOS.find(function(n) { return n.id === id; });
  if (!nacho) return;
  if (inCrawl(id)) { crawl = crawl.filter(function(n) { return n.id !== id; }); }
  else { crawl.push(nacho); }
  renderCrawlSidebar(); renderCards(); updateCrawlBar(); updateRoutePanel();
}

function removeFromCrawl(id) {
  crawl = crawl.filter(function(n) { return n.id !== id; });
  renderCrawlSidebar(); renderCards(); updateCrawlBar(); updateRoutePanel();
}

function clearCrawl() {
  crawl = [];
  renderCrawlSidebar(); renderCards(); updateCrawlBar(); updateRoutePanel();
}

function renderCards() {
  var filtered = getFiltered();
  var grid = document.getElementById('nacho-grid');
  var noResults = document.getElementById('no-results');
  var tagLabels = { veggie: '🥦 Veggie', vegan: '🌱 Vegan', spicy: '🌶 Spicy', pork: '🐷 Pork', seafood: '🦐 Seafood', 'gluten-free': '🌾 GF' };
  document.getElementById('section-count').textContent = filtered.length + ' nacho' + (filtered.length !== 1 ? 's' : '');
  if (filtered.length === 0) { grid.innerHTML = ''; noResults.style.display = 'block'; return; }
  noResults.style.display = 'none';
  var html = '';
  for (var i = 0; i < filtered.length; i++) {
    var n = filtered[i];
    var added = inCrawl(n.id);
    var v = visits[n.id];
    var hasScore = v && v.score > 0;
    var tagHtml = n.tags.map(function(t) { return '<span class="tag tag-' + t + '">' + (tagLabels[t] || t) + '</span>'; }).join('');
    var badgeColor = hasScore ? (v.score <= 5 ? '#D9231B' : (v.score <= 8 ? '#E8A838' : '#2C6B3F')) : '';
    var scoreBadge = hasScore ? '<div class="card-score-badge" style="background:' + badgeColor + '">' + v.score + '/10</div>' : '';
    var rateBtnClass = 'rate-btn' + (hasScore ? ' rated' : '');
    var rateBtnLabel = hasScore ? ('⭐ ' + v.score + '/10') : 'Rate It';
    html += '<div class="nacho-card' + (added ? ' in-crawl' : '') + (hasScore ? ' is-rated' : '') + '" onclick="toggleCrawl(' + n.id + ')">';
    html += scoreBadge;
    html += '<div class="card-neighborhood">' + n.neighborhood + (n.subArea ? ' · ' + n.subArea : '') + '</div>';
    html += '<div class="card-restaurant">' + n.restaurant + '</div>';
    html += '<div class="card-nacho-name">&ldquo;' + n.nachoName + '&rdquo;</div>';
    html += '<div class="card-address">📍 ' + n.address + '</div>';
    html += '<div class="card-desc">' + n.desc + '</div>';
    html += '<div class="card-footer">';
    html += '<div class="card-price">$10 / nacho</div>';
    html += '<div class="card-tags">' + tagHtml + '</div>';
    html += '<button class="add-btn' + (added ? ' added' : '') + '">' + (added ? '✓ Added' : '+ Add') + '</button>';
    html += '<button class="' + rateBtnClass + '" onclick="event.stopPropagation();rateFromCard(' + n.id + ')">' + rateBtnLabel + '</button>';
    html += '</div></div>';
  }
  grid.innerHTML = html;
  updateCounts();
}

function updateCounts() {
  var nbhds = ['Northwest','Southwest','Northeast','North','Southeast','Beaverton','Lake Oswego','Tigard','Vancouver'];
  var tags = ['veggie','vegan','spicy','pork','seafood','gluten-free'];
  document.getElementById('count-all').textContent = NACHOS.length;
  nbhds.forEach(function(n) {
    var el = document.getElementById('count-' + n);
    if (el) el.textContent = NACHOS.filter(function(x) { return x.neighborhood === n; }).length;
  });
  document.getElementById('tag-count-all').textContent = NACHOS.length;
  tags.forEach(function(t) {
    var el = document.getElementById('tag-count-' + t);
    if (el) el.textContent = NACHOS.filter(function(x) { return x.tags.indexOf(t) > -1; }).length;
  });
}

function renderCrawlSidebar() {
  var list = document.getElementById('crawl-list');
  var total = document.getElementById('crawl-total');
  if (crawl.length === 0) {
    list.innerHTML = '<li style="border:none;background:none;padding:0"><span class="empty-crawl">No stops yet.<br>Tap a nacho card to add!</span></li>';
    total.textContent = '';
    return;
  }
  var html = '';
  for (var i = 0; i < crawl.length; i++) {
    var n = crawl[i];
    html += '<li><div>';
    html += '<div class="crawl-item-name">' + (i+1) + '. ' + n.restaurant + '</div>';
    html += '<div class="crawl-item-sub">' + n.nachoName + '</div>';
    html += '</div><button class="remove-btn" onclick="event.stopPropagation();removeFromCrawl(' + n.id + ')">✕</button></li>';
  }
  list.innerHTML = html;
  total.textContent = crawl.length + ' stops · $' + (crawl.length * 10);
}

function updateCrawlBar() {
  document.getElementById('crawl-count').textContent = crawl.length;
  document.getElementById('total-cost').textContent = '$' + (crawl.length * 10);
}

function updateRoutePanel() {
  var panel = document.getElementById('route-panel');
  if (crawl.length < 2) { panel.classList.remove('visible'); return; }
  panel.classList.add('visible');
  setTimeout(function() { panel.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 50);
  var html = '';
  for (var i = 0; i < crawl.length; i++) {
    var n = crawl[i];
    html += '<div class="route-stop">';
    html += '<div class="stop-num">Stop ' + (i+1) + ' · $10</div>';
    html += '<div class="stop-name">' + n.restaurant + '</div>';
    html += '<div class="stop-nacho">&ldquo;' + n.nachoName + '&rdquo;</div>';
    if (i < crawl.length - 1) html += '<div style="font-size:0.55rem;color:var(--nacho);margin-top:0.3rem">🚶 ~10–15 min walk to next stop</div>';
    html += '</div>';
  }
  document.getElementById('route-stops').innerHTML = html;
  var addresses = crawl.map(function(n) { return encodeURIComponent(n.address + ' Portland OR'); });
  addresses.push(addresses[0]);
  document.getElementById('map-link').href = 'https://www.google.com/maps/dir/' + addresses.join('/') + '?travelmode=walking';
}

function openPopup(nachoId) {
  popupNachoId = nachoId;
  var n = NACHOS.find(function(x) { return x.id === nachoId; });
  if (!n) return;
  document.getElementById('popup-restaurant').textContent = n.restaurant;
  document.getElementById('popup-nacho').textContent = n.nachoName;
  var v = visits[nachoId] || { score: 0, note: '' };
  document.getElementById('popup-note').value = v.note || '';
  var btns = '';
  for (var i = 1; i <= 10; i++) {
    btns += '<button class="score-btn' + (v.score === i ? ' selected' : '') + '" onclick="selectScore(' + i + ')">' + i + '</button>';
  }
  document.getElementById('score-buttons').innerHTML = btns;
  document.getElementById('popup-overlay').classList.add('visible');
}

function selectScore(n) {
  document.getElementById('score-buttons').querySelectorAll('.score-btn').forEach(function(b, i) { b.classList.toggle('selected', i + 1 === n); });
}

function getSelectedScore() {
  var btns = document.getElementById('score-buttons').querySelectorAll('.score-btn');
  for (var i = 0; i < btns.length; i++) { if (btns[i].classList.contains('selected')) return i + 1; }
  return 0;
}

function saveRating() {
  if (!popupNachoId) return;
  var score = getSelectedScore();
  var note = document.getElementById('popup-note').value;
  if (score === 0) { alert('Please select a score first!'); return; }
  visits[popupNachoId] = { score: score, note: note };
  saveVisitsToURL();
  closePopupDirect();
  renderCards();
  showToast('✓ Rating saved!');
}

function closePopup(e) { if (e.target === document.getElementById('popup-overlay')) closePopupDirect(); }
function closePopupDirect() { document.getElementById('popup-overlay').classList.remove('visible'); popupNachoId = null; }

function rateFromCard(nachoId) {
  if (!visits[nachoId]) visits[nachoId] = { score: 1, note: '' };
  saveVisitsToURL();
  renderCards();
  openPopup(nachoId);
}

function renderVisits() {
  var grid = document.getElementById('visits-grid');
  var empty = document.getElementById('visits-empty');
  var summaryBar = document.getElementById('visits-summary-bar');
  var visited = NACHOS.filter(function(n) { return visits[n.id] && visits[n.id].score > 0; });
  if (visited.length === 0) { grid.innerHTML = ''; empty.style.display = 'block'; summaryBar.innerHTML = ''; return; }
  empty.style.display = 'none';
  var total = visited.reduce(function(s,n) { return s + visits[n.id].score; }, 0);
  var avg = (total / visited.length).toFixed(1);
  var top = visited.slice().sort(function(a,b) { return visits[b.id].score - visits[a.id].score; })[0];
  summaryBar.innerHTML = '<div class="visits-summary"><div class="summary-stat"><div class="summary-num">' + visited.length + '</div><div class="summary-label">Tasted</div></div><div class="summary-stat"><div class="summary-num">' + avg + '</div><div class="summary-label">Avg Score</div></div><div class="summary-stat"><div class="summary-num" style="font-size:1rem;padding-top:0.5rem">' + top.nachoName + '</div><div class="summary-label">Top Rated at ' + top.restaurant + '</div></div></div>';
  var html = '';
  var sorted = visited.slice().sort(function(a,b) { return visits[b.id].score - visits[a.id].score; });
  for (var j = 0; j < sorted.length; j++) {
    var n = sorted[j];
    var v = visits[n.id];
    var pips = '';
    for (var i = 1; i <= 10; i++) {
      var pipColor = i <= v.score ? (i <= 5 ? '#D9231B' : (i <= 8 ? '#E8A838' : '#2C6B3F')) : '#eee';
      pips += '<div class="score-pip" style="background:' + pipColor + '" onclick="openPopup(' + n.id + ')"></div>';
    }
    var badgeColor = v.score <= 5 ? '#D9231B' : (v.score <= 8 ? '#E8A838' : '#2C6B3F');
    html += '<div class="visit-card">';
    html += '<div class="visit-score-badge" style="background:' + badgeColor + ';color:' + (v.score <= 8 ? '#0F0F0F' : 'white') + '">' + v.score + '</div>';
    html += '<div class="visit-card-nbhd">' + n.neighborhood + ' · ' + n.subArea + '</div>';
    html += '<div class="visit-card-restaurant">' + n.restaurant + '</div>';
    html += '<div class="visit-card-nacho">' + n.nachoName + '</div>';
    html += '<div class="visit-score-bar">' + pips + '</div>';
    if (v.note) html += '<div class="visit-note-display">&ldquo;' + v.note + '&rdquo;</div>';
    html += '<button class="visit-edit-btn" onclick="openPopup(' + n.id + ')">Edit Rating</button>';
    html += '</div>';
  }
  grid.innerHTML = html;
}

function saveVisitsToURL() {
  var parts = Object.keys(visits).filter(function(id) { return visits[id].score > 0; }).map(function(id) {
    var v = visits[id];
    var noteEnc = v.note ? btoa(unescape(encodeURIComponent(v.note))) : '';
    return id + ':' + v.score + ':' + noteEnc;
  });
  var url = new URL(window.location.href);
  if (parts.length > 0) url.searchParams.set('visits', parts.join(','));
  else url.searchParams.delete('visits');
  window.history.replaceState({}, '', url.toString());
  try { localStorage.setItem('pdxcrawl_nacho_visits', JSON.stringify(visits)); } catch(e) {}
}

function shareCrawl() {
  if (crawl.length === 0) return;
  var ids = crawl.map(function(n) { return n.id; }).join(',');
  var url = window.location.origin + window.location.pathname + '?crawl=' + ids;
  doShare('PDX Nacho Crawl', 'Check out my Nacho Week crawl! 🧀', url, '✓ Crawl link copied!');
}

function shareVisits() {
  doShare('My Nacho Week Ratings', 'My Nacho Week ratings! 🧀⭐', window.location.href, '✓ Ratings link copied!');
}

function doShare(title, text, url, msg) {
  if (navigator.share) { navigator.share({ title: title, text: text, url: url }); }
  else if (navigator.clipboard) { navigator.clipboard.writeText(url).then(function() { showToast(msg); }); }
  else { prompt('Copy this link:', url); }
}

function showToast(msg) {
  var t = document.getElementById('share-toast');
  t.textContent = msg;
  t.classList.add('visible');
  setTimeout(function() { t.classList.remove('visible'); }, 3000);
}

function loadCrawlFromURL() {
  var params = new URLSearchParams(window.location.search);
  var ids = params.get('crawl');
  if (!ids) return;
  ids.split(',').forEach(function(id) {
    var n = NACHOS.find(function(x) { return x.id === parseInt(id); });
    if (n) crawl.push(n);
  });
  if (crawl.length > 0) { renderCrawlSidebar(); renderCards(); updateCrawlBar(); updateRoutePanel(); }
}

function loadVisitsFromStorage() {
  try {
    var stored = localStorage.getItem('pdxcrawl_nacho_visits');
    if (stored) {
      var parsed = JSON.parse(stored);
      Object.keys(parsed).forEach(function(id) {
        var v = parsed[id];
        if (v && v.score > 0) visits[parseInt(id)] = { score: v.score, note: v.note || '' };
      });
    }
  } catch(e) {}
}

function loadVisitsFromURL() {
  var params = new URLSearchParams(window.location.search);
  var raw = params.get('visits');
  if (!raw) return;
  raw.split(',').forEach(function(part) {
    var bits = part.split(':');
    var id = parseInt(bits[0]);
    var score = parseInt(bits[1]) || 0;
    var note = '';
    try { note = bits[2] ? decodeURIComponent(escape(atob(bits[2]))) : ''; } catch(e) {}
    if (id && score > 0) visits[id] = { score: score, note: note };
  });
}

