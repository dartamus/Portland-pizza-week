function getRotatedStops(route) {
  var uniqueIds = [];
  route.stops.forEach(function(s) { if (uniqueIds.indexOf(s.nachoId) === -1) uniqueIds.push(s.nachoId); });
  var startIdx = routeStartIndex[route.id] || 0;
  return uniqueIds.slice(startIdx).concat(uniqueIds.slice(0, startIdx));
}

function setRouteStart(routeId, idx) { routeStartIndex[routeId] = idx; renderRoutes(); }

function loadSuggestedRoute(routeId) {
  var route = ROUTES.find(function(r) { return r.id === routeId; });
  if (!route) return;
  crawl = getRotatedStops(route).map(function(id) { return NACHOS.find(function(n) { return n.id === id; }); }).filter(Boolean);
  renderCrawlSidebar(); renderCards(); updateCrawlBar(); updateRoutePanel();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function buildMapUrl(route) {
  var items = getRotatedStops(route).map(function(id) { return NACHOS.find(function(n) { return n.id === id; }); }).filter(Boolean);
  var addresses = items.map(function(n) { return encodeURIComponent(n.address + ' Portland OR'); });
  if (addresses.length > 0) addresses.push(addresses[0]);
  return 'https://www.google.com/maps/dir/' + addresses.join('/') + '?travelmode=walking';
}

function renderRoutes() {
  var grid = document.getElementById('routes-grid');
  var html = '';
  for (var r = 0; r < ROUTES.length; r++) {
    var route = ROUTES[r];
    var origIds = [];
    route.stops.forEach(function(s) { if (origIds.indexOf(s.nachoId) === -1) origIds.push(s.nachoId); });
    var startIdx = routeStartIndex[route.id] || 0;
    var stopsHtml = '';
    for (var s = 0; s < origIds.length; s++) {
      var nid = origIds[s];
      var n = NACHOS.find(function(x) { return x.id === nid; });
      if (!n) continue;
      var isStart = s === startIdx;
      var displayNum = ((s - startIdx + origIds.length) % origIds.length) + 1;
      stopsHtml += '<li class="' + (isStart ? 'is-start' : '') + '" onclick="setRouteStart(\'' + route.id + '\',' + s + ')">';
      stopsHtml += '<div class="stop-num-dot" style="' + (isStart ? 'background:#E8A838;color:#0F0F0F' : '') + '">' + (isStart ? '★' : displayNum) + '</div>';
      stopsHtml += '<div class="stop-info"><div class="stop-info-restaurant">' + n.restaurant + '</div><div class="stop-info-name">' + n.nachoName + '</div></div>';
      stopsHtml += '<span class="start-hint" style="color:' + (isStart ? '#E8A838' : '#555') + '">' + (isStart ? 'START' : 'tap') + '</span>';
      stopsHtml += '</li>';
    }
    html += '<div class="route-card" style="border-top-color:' + route.accentColor + '">';
    html += '<div class="route-card-nbhd">' + route.neighborhood + '</div>';
    html += '<div class="route-card-name">' + route.name + '</div>';
    html += '<div class="route-meta"><span class="route-badge badge-dist">🚶 ' + route.distanceMi + ' mi</span><span class="route-badge badge-stops">🧀 ' + origIds.length + ' stops</span><span class="route-badge badge-cost">💰 $' + (origIds.length * 10) + ' total</span></div>';
    html += '<div class="route-desc">' + route.description + '</div>';
    html += '<ul class="route-stops-list">' + stopsHtml + '</ul>';
    html += '<div class="route-actions"><button class="route-load-btn" onclick="loadSuggestedRoute(\'' + route.id + '\')">🧀 Load This Crawl</button><a class="route-map-btn" href="' + buildMapUrl(route) + '" target="_blank">Map →</a></div>';
    html += '</div>';
  }
  grid.innerHTML = html;
}

updateCounts();
renderCards();
renderRoutes();
