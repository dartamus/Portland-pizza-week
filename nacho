  .header-tagline { font-family: 'Instrument Serif', serif; font-style: italic; font-size: 1.1rem; color: rgba(250,243,232,0.55); margin-top: 0.85rem; }
  .header-logo { width: 160px; height: 160px; object-fit: contain; display: block; }
  .header-divider { height: 1px; background: linear-gradient(to right, transparent, rgba(200,134,10,0.4), transparent); margin: 1.75rem 0 0; }
