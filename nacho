  .routes-top p { font-size: 0.65rem; color: #AAA; font-style: italic; }
  .routes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
  .route-card { background: #2a2a2a !important; border: 1.5px solid #444; border-top: 3px solid var(--nacho); padding: 1rem; }
  .route-card-nbhd { font-size: 0.58rem; color: var(--nacho); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.15rem; font-weight: 700; }
